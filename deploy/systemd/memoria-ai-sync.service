[Unit]
Description=Memoria AI Anti - Nightly Ingestion & Backup Job
After=network.target

[Service]
Type=oneshot
User=gas
WorkingDirectory=/home/gas/memoria_ai_anti
ExecStart=/bin/bash -c '\
  /home/gas/memoria_ai_anti/venv/bin/python -m memoria.cli.main ingest /home/gas/.claude/projects --provider claude_code --db /home/gas/.memoria/vault.db && \
  sqlite3 /home/gas/.memoria/vault.db ".backup /home/gas/.memoria/vault_backup_$(date +%%Y%%m%%d).db" && \
  find /home/gas/.memoria -name "vault_backup_*.db" -mtime +14 -delete'
