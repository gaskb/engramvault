[Unit]
Description=Memoria AI Anti - Web Dashboard & Vault Service
After=network.target

[Service]
Type=simple
User=gas
WorkingDirectory=/home/gas/memoria_ai_anti
ExecStart=/home/gas/memoria_ai_anti/venv/bin/python -m memoria.cli.main serve --host 0.0.0.0 --port 8080 --db /home/gas/.memoria/vault.db
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
