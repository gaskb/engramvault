# ==============================================================================
# EngramVault - Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# Core Application Settings
ENGRAMVAULT_APP_TITLE="EngramVault"
ENGRAMVAULT_APP_SUBTITLE="AI Memory Vault"
ENGRAMVAULT_INSTANCE_NAME="Local Node"
ENGRAMVAULT_DEFAULT_LANG="en"                # 'en' or 'it'
ENGRAMVAULT_DEFAULT_THEME="emerald"          # emerald, indigo, slate, amber, ruby

# Data Directories & Storage
ENGRAMVAULT_DATA_DIR="./data"
ENGRAMVAULT_DB_PATH="./data/vault.db"
ENGRAMVAULT_INCOMING_DIR="./data/incoming"

# Security & Authentication (Leave empty for open local development)
ENGRAMVAULT_API_TOKEN=""                     # Bearer token for REST & MCP endpoints
ENGRAMVAULT_WEB_PASSWORD=""                  # Password for web dashboard access
ENGRAMVAULT_MAX_UPLOAD_MB=100

# Watcher Settings (Auto-import from incoming folder)
ENGRAMVAULT_WATCH_ENABLED="true"
ENGRAMVAULT_WATCH_INTERVAL=5                 # Seconds between directory checks

# Search & Ranking (Reciprocal Rank Fusion - RRF)
ENGRAMVAULT_RRF_K=60
ENGRAMVAULT_BM25_WEIGHT=1.0
ENGRAMVAULT_VEC_WEIGHT=1.0
ENGRAMVAULT_EMBEDDING_BACKEND="auto"         # 'auto', 'native', 'fastembed', 'api'

# LLM Extraction & Knowledge Curation (Optional Cloud/Local Providers)
# Leave empty to use offline heuristic extraction.
ENGRAMVAULT_LLM_PROVIDER=""                  # 'openai', 'anthropic', 'gemini', 'grok', 'deepseek', 'qwen'
ENGRAMVAULT_LLM_BASE_URL="http://localhost:11434/v1"
ENGRAMVAULT_LLM_API_KEY=""
ENGRAMVAULT_LLM_MODEL="qwen2.5:3b"

# Optional Fast System 1 Router (Jev / OpenRouter)
ENGRAMVAULT_JEV_ENABLED="false"
ENGRAMVAULT_JEV_BASE_URL="https://openrouter.ai/api/v1"
ENGRAMVAULT_JEV_API_KEY=""
ENGRAMVAULT_JEV_MODEL="typesafe/jev-1.13"

# Links & Branding
ENGRAMVAULT_DOCS_URL="https://engramvault.net"
ENGRAMVAULT_REPO_URL="https://github.com/gaskb/engramvault"
